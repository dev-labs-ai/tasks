# Development values only. Copy to .env (make does it on first run) and
# never commit real credentials.

# PostgreSQL container (docker compose)
POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasks
POSTGRES_PORT=5432

# API (DATABASE_URL must match the POSTGRES_* values above)
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
PORT=8080
APP_ENV=development

# Web, development only: where nuxt dev proxies /api
API_URL=http://localhost:8080

# Production-like stack (docker compose up): where the web container listens
WEB_PORT=8088
