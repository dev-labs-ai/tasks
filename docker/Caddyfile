# One origin for the SPA and the API (tech spec §2). Set DOMAIN to a host
# name for automatic HTTPS; without it Caddy serves plain HTTP on :80.
{$DOMAIN::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Build assets have content hashes in their names.
		@assets path /_nuxt/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Every other path is a client-side route: serve the SPA.
		try_files {path} /index.html
		file_server
	}
}
